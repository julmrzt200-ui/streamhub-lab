    const-string v3, "(function(){\n  function stop(doc){\n    try {\n      doc.querySelectorAll(\'track\').forEach(function(t){\n        try { if (t.src) fetch(t.src); } catch(e) {}\n      });\n      doc.querySelectorAll(\'video,audio\').forEach(function(m){\n        try {\n          m.muted = true; m.volume = 0; m.autoplay = false; m.pause();\n          m.removeAttribute(\'src\'); m.srcObject = null;\n          while (m.firstChild) m.removeChild(m.firstChild);\n          m.load();\n        } catch(e) {}\n      });\n      var f = doc.querySelectorAll(\'iframe\');\n      for (var i = 0; i < f.length; i++) {\n        try { if (f[i].contentDocument) stop(f[i].contentDocument); } catch(e) {}\n      }\n    } catch(e) {}\n  }\n  stop(document);\n})();"

