    const-string v3, "(function(){\n  function hush(doc){\n    try {\n      doc.querySelectorAll(\'video,audio\').forEach(function(m){\n        try { m.muted = true; m.volume = 0; } catch(e) {}\n      });\n      var f = doc.querySelectorAll(\'iframe\');\n      for (var i = 0; i < f.length; i++) {\n        try { if (f[i].contentDocument) hush(f[i].contentDocument); } catch(e) {}\n      }\n    } catch(e) {}\n  }\n  hush(document);\n})();"

