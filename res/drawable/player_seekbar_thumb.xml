<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <size android:height="22.0dp" android:width="22.0dp" />
                    <solid android:color="#00000000" />
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <size android:height="22.0dp" android:width="22.0dp" />
                    <solid android:color="@color/clipbox_red" />
                    <stroke android:width="4.0dp" android:color="#ffffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <size android:height="22.0dp" android:width="22.0dp" />
                    <solid android:color="#00000000" />
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <size android:height="16.0dp" android:width="16.0dp" />
                    <solid android:color="@color/clipbox_red" />
                    <stroke android:width="2.5dp" android:color="#ffffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
