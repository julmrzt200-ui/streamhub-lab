    .locals 1

    .line 1
    iget v0, p0, Lr01;->d:I

    sparse-switch v0, :sswitch_data_0

    invoke-super {p0}, LMm0;->j()I

    move-result v0

    return v0

    :sswitch_0
    const/4 v0, 0x2

    return v0

    :sswitch_1
    const/4 v0, 0x2

    return v0

    :sswitch_2
    const/4 v0, 0x2

    return v0

    :sswitch_data_0
    .sparse-switch
        0x0 -> :sswitch_2
        0x2 -> :sswitch_1
        0xc -> :sswitch_0
    .end sparse-switch
.end method
